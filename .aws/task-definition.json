{
  "family": "grupolink-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "grupolink-backend",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/grupolink-backend:latest",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "PORT", "value": "8080" },
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" }
      ],
      "secrets": [
        { "name": "DB_HOST",              "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/DB_HOST" },
        { "name": "DB_PORT",              "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/DB_PORT" },
        { "name": "DB_NAME",              "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/DB_NAME" },
        { "name": "DB_USER",              "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/DB_USER" },
        { "name": "DB_PASSWORD",          "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/DB_PASSWORD" },
        { "name": "REDIS_HOST",           "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/REDIS_HOST" },
        { "name": "REDIS_PORT",           "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/REDIS_PORT" },
        { "name": "RABBITMQ_HOST",        "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/RABBITMQ_HOST" },
        { "name": "RABBITMQ_USER",        "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/RABBITMQ_USER" },
        { "name": "RABBITMQ_PASS",        "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/RABBITMQ_PASS" },
        { "name": "JWT_SECRET",           "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/JWT_SECRET" },
        { "name": "BASE_URL",             "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/BASE_URL" },
        { "name": "FRONTEND_URL",         "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/FRONTEND_URL" },
        { "name": "MP_ACCESS_TOKEN",      "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/MP_ACCESS_TOKEN" },
        { "name": "MP_WEBHOOK_SECRET",    "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/MP_WEBHOOK_SECRET" },
        { "name": "WHATSAPP_APP_SECRET",  "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/WHATSAPP_APP_SECRET" },
        { "name": "WHATSAPP_WEBHOOK_VERIFY_TOKEN", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/WHATSAPP_WEBHOOK_VERIFY_TOKEN" },
        { "name": "GOOGLE_CLIENT_ID",     "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/GOOGLE_CLIENT_ID" },
        { "name": "GOOGLE_CLIENT_SECRET", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/grupolink/GOOGLE_CLIENT_SECRET" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/grupolink-backend",
          "awslogs-region":        "REGION",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command":     ["CMD-SHELL", "curl -f http://localhost:8080/actuator/health || exit 1"],
        "interval":    30,
        "timeout":     5,
        "retries":     3,
        "startPeriod": 60
      }
    }
  ]
}
