# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_saas
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# JWT (mínimo 256 bits)
JWT_SECRET=mude-esse-secret-em-producao-use-256-bits-no-minimo

# URLs
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# WhatsApp Cloud API
WHATSAPP_API_VERSION=v19.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=mude-este-token

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AWS S3 — upload de imagens de mensagens
S3_BUCKET=grupolink-media
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# S3_BASE_URL=https://cdn.seudominio.com  (opcional — CDN na frente do bucket)

# AWS SES — envio de e-mails (pode reutilizar as mesmas credenciais do S3)
SES_REGION=us-east-1
SES_ACCESS_KEY=
SES_SECRET_KEY=
SES_FROM_EMAIL=noreply@redirectgrupo.com.br
CONTACT_EMAIL=contato@redirectgrupo.com.br
