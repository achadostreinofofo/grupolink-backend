# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=whatsapp_saas
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# JWT (mínimo 256 bits)
JWT_SECRET=mude-esse-secret-em-producao-use-256-bits-no-minimo

# URLs
BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# WhatsApp Cloud API
WHATSAPP_API_VERSION=v19.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=mude-este-token

# Mercado Pago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Google OAuth2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AWS — credenciais únicas para S3 e SES ──────────────────────
# Use as mesmas chaves que você já tem configuradas em produção.
# O SDK do Java lê AWS_ACCESS_KEY_ID e AWS_SECRET_ACCESS_KEY automaticamente;
# não é necessário duplicar para S3 e SES separadamente.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS S3 — bucket de upload de imagens
S3_BUCKET=grupolink-media
S3_REGION=us-east-1
# S3_BASE_URL=https://cdn.seudominio.com  (opcional — CDN na frente do bucket)

# AWS SES — envio de e-mails (usa a mesma região do S3 por padrão)
SES_FROM_EMAIL=noreply@redirectgrupo.com.br
CONTACT_EMAIL=contato@redirectgrupo.com.br
